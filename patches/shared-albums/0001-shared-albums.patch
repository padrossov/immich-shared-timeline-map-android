diff --git a/mobile/lib/infrastructure/repositories/shared_album_queries.dart b/mobile/lib/infrastructure/repositories/shared_album_queries.dart
new file mode 100644
index 0000000..d4a6f68
--- /dev/null
+++ b/mobile/lib/infrastructure/repositories/shared_album_queries.dart
@@ -0,0 +1,185 @@
+import 'package:drift/drift.dart';
+import 'package:immich_mobile/data/db/main/database.dart';
+import 'package:immich_mobile/data/db/main/table/local/asset.dart';
+import 'package:immich_mobile/data/db/main/table/remote/asset.dart';
+import 'package:immich_mobile/domain/models/asset/base_asset.model.dart';
+import 'package:immich_mobile/domain/models/map.model.dart';
+import 'package:immich_mobile/domain/models/timeline.model.dart';
+import 'package:immich_mobile/domain/services/timeline.service.dart';
+import 'package:immich_mobile/infrastructure/repositories/shared_album_sql.dart';
+import 'package:intl/intl.dart';
+import 'package:maplibre_gl/maplibre_gl.dart';
+
+/// Extra queries are used only while at least one shared album is selected.
+/// The stock queries remain the fallback when the selection is empty.
+class SharedAlbumQueries {
+  final Drift db;
+  const SharedAlbumQueries(this.db);
+
+  Selectable<QueryRow> _select(SharedAlbumSql query, String suffix, [List<Object> arguments = const []]) =>
+      db.customSelect(
+        '${query.sql} $suffix',
+        variables: [...query.arguments, ...arguments]
+            .map(
+              (value) => switch (value) {
+                final String v => Variable<String>(v),
+                final int v => Variable<int>(v),
+                final double v => Variable<double>(v),
+                _ => throw ArgumentError.value(value, 'SQL parameter'),
+              },
+            )
+            .toList(),
+        readsFrom: {
+          db.remoteAssetEntity,
+          db.remoteExifEntity,
+          db.remoteAlbumEntity,
+          db.remoteAlbumAssetEntity,
+          db.remoteAlbumUserEntity,
+          db.stackEntity,
+          db.localAssetEntity,
+          db.localAlbumEntity,
+          db.localAlbumAssetEntity,
+        },
+      );
+
+  Stream<List<({String id, String name})>> watchAlbums(String userId) => db
+      .customSelect(
+        SharedAlbumSql.accessibleAlbums,
+        variables: [Variable(userId), Variable(userId)],
+        readsFrom: {db.remoteAlbumEntity, db.remoteAlbumUserEntity},
+      )
+      .watch()
+      .map((rows) => rows.map((row) => (id: row.read<String>('id'), name: row.read<String>('name'))).toList());
+
+  TimelineQuery main(List<String> userIds, String userId, List<String> albumIds, GroupAssetsBy groupBy) {
+    final query = SharedAlbumSql.candidates(
+      ownerIds: userIds,
+      albumIds: albumIds,
+      currentUserId: userId,
+    ).mainRows(userIds);
+    return (
+      origin: TimelineOrigin.main,
+      bucketSource: () => _buckets(query, 'visible', groupBy),
+      assetSource: (offset, count) => _assets(query, 'visible', offset, count, groupBy, userIds),
+    );
+  }
+
+  SharedAlbumSql _map(List<String> userIds, TimelineMapOptions options, {LatLngBounds? bounds}) {
+    final area = bounds ?? options.bounds;
+    final range = options.timeRange;
+    final hasRange = range.from != null || range.to != null;
+    return SharedAlbumSql.candidates(
+      ownerIds: userIds,
+      albumIds: options.sharedAlbumIds,
+      currentUserId: options.sharedAlbumUserId,
+      map: true,
+      includeArchived: options.includeArchived,
+      onlyFavorites: options.onlyFavorites,
+      south: area.southwest.latitude,
+      north: area.northeast.latitude,
+      west: area.southwest.longitude,
+      east: area.northeast.longitude,
+      from: hasRange
+          ? range.from
+          : options.relativeDays > 0
+          ? DateTime.now().toUtc().subtract(Duration(days: options.relativeDays))
+          : null,
+      to: hasRange ? range.to : null,
+    );
+  }
+
+  TimelineQuery map(List<String> userIds, TimelineMapOptions options, GroupAssetsBy groupBy) {
+    final query = _map(userIds, options);
+    return (
+      origin: TimelineOrigin.map,
+      bucketSource: () => _buckets(query, 'visible_remote', groupBy),
+      assetSource: (offset, count) => _assets(query, 'visible_remote', offset, count, groupBy, userIds),
+    );
+  }
+
+  Future<List<Marker>> markers(List<String> userIds, TimelineMapOptions options, LatLngBounds? bounds) async {
+    final query = _map(
+      userIds,
+      options,
+      bounds: bounds ?? LatLngBounds(southwest: const LatLng(-90, -180), northeast: const LatLng(90, 180)),
+    );
+    final rows = await _select(
+      query,
+      'SELECT id, latitude, longitude FROM visible_remote ORDER BY id LIMIT 10000',
+    ).get();
+    return rows
+        .map(
+          (row) => Marker(
+            assetId: row.read<String>('id'),
+            location: LatLng(row.read<double>('latitude'), row.read<double>('longitude')),
+          ),
+        )
+        .toList();
+  }
+
+  String _date(GroupAssetsBy groupBy) {
+    final format = groupBy == GroupAssetsBy.month ? '%Y-%m' : '%Y-%m-%d';
+    return "COALESCE(strftime('$format', local_date_time), strftime('$format', created_at, 'localtime'))";
+  }
+
+  Stream<List<Bucket>> _buckets(SharedAlbumSql query, String table, GroupAssetsBy groupBy) {
+    if (groupBy == GroupAssetsBy.none) {
+      return _select(query, 'SELECT count(*) AS asset_count FROM $table').watch().map((rows) {
+        final count = rows.single.read<int>('asset_count');
+        return count == 0 ? <Bucket>[] : [Bucket(assetCount: count)];
+      });
+    }
+    return _select(query, '''SELECT ${_date(groupBy)} AS bucket_date, count(*) AS asset_count
+      FROM $table GROUP BY bucket_date ORDER BY bucket_date DESC''').watch().map(
+      (rows) => rows
+          .map(
+            (row) => TimeBucket(
+              date: DateFormat(
+                groupBy == GroupAssetsBy.month ? 'y-M' : 'y-M-d',
+                'en',
+              ).parse(row.read<String>('bucket_date')),
+              assetCount: row.read<int>('asset_count'),
+            ),
+          )
+          .toList(),
+    );
+  }
+
+  Future<List<BaseAsset>> _assets(
+    SharedAlbumSql query,
+    String table,
+    int offset,
+    int count,
+    GroupAssetsBy groupBy,
+    List<String> stackOwnerIds,
+  ) async {
+    // Resolve IDs and their DTOs in one snapshot so a concurrent sync cannot
+    // remove an entity between the page query and the DTO lookup.
+    return db.transaction(() async {
+      final main = table == 'visible';
+      final columns = main ? 'remote_id, local_id' : 'id AS remote_id, NULL AS local_id';
+      final stableId = main ? 'COALESCE(remote_id, local_id)' : 'id';
+      final order = groupBy == GroupAssetsBy.none ? '' : '${_date(groupBy)} DESC,';
+      final rows = await _select(
+        query,
+        'SELECT $columns FROM $table ORDER BY $order created_at DESC, $stableId LIMIT ? OFFSET ?',
+        [count, offset],
+      ).get();
+      final remoteIds = rows.map((row) => row.readNullable<String>('remote_id')).nonNulls.toList();
+      final localIds = rows.map((row) => row.readNullable<String>('local_id')).nonNulls.toList();
+      final remote = await (db.remoteAssetEntity.select()..where((a) => a.id.isIn(remoteIds))).get();
+      final local = await (db.localAssetEntity.select()..where((a) => a.id.isIn(localIds))).get();
+      final remoteById = {for (final asset in remote) asset.id: asset};
+      final localById = {for (final asset in local) asset.id: asset};
+      return rows.map((row) {
+        final remoteId = row.readNullable<String>('remote_id');
+        final localId = row.readNullable<String>('local_id');
+        if (remoteId == null) {
+          return localById[localId]!.toDto();
+        }
+        final asset = remoteById[remoteId]!;
+        return asset.toDto(localId: localId, includeStack: stackOwnerIds.contains(asset.ownerId));
+      }).toList();
+    });
+  }
+}
diff --git a/mobile/lib/infrastructure/repositories/shared_album_sql.dart b/mobile/lib/infrastructure/repositories/shared_album_sql.dart
new file mode 100644
index 0000000..f8fe156
--- /dev/null
+++ b/mobile/lib/infrastructure/repositories/shared_album_sql.dart
@@ -0,0 +1,129 @@
+/// SQL shared by the extra timeline and map queries. All user values are bound.
+/// Filtering precedes checksum ranking, counting and pagination.
+class SharedAlbumSql {
+  final String sql;
+  final List<Object> arguments;
+
+  const SharedAlbumSql(this.sql, this.arguments);
+
+  static const accessibleAlbums = '''
+SELECT album.id, album.name
+FROM remote_album_entity album
+WHERE EXISTS (
+  SELECT 1 FROM remote_album_user_entity mine
+  WHERE mine.album_id = album.id AND mine.user_id = ?
+) AND EXISTS (
+  SELECT 1 FROM remote_album_user_entity other
+  WHERE other.album_id = album.id AND other.user_id <> ?
+)
+ORDER BY album.name COLLATE NOCASE, album.id
+''';
+
+  factory SharedAlbumSql.candidates({
+    required List<String> ownerIds,
+    required List<String> albumIds,
+    required String currentUserId,
+    bool map = false,
+    bool includeArchived = false,
+    bool onlyFavorites = false,
+    double south = -90,
+    double north = 90,
+    double west = -180,
+    double east = 180,
+    DateTime? from,
+    DateTime? to,
+  }) {
+    final arguments = <Object>[];
+    String bind(Object value) {
+      arguments.add(value);
+      return '?';
+    }
+
+    String inList(List<String> values) => values.isEmpty ? '(NULL)' : '(${values.map(bind).join(',')})';
+
+    final owners = inList(ownerIds);
+    final albums = inList(albumIds);
+    final mine = bind(currentUserId);
+    final other = bind(currentUserId);
+    final filters = <String>[
+      'a.deleted_at IS NULL',
+      'a.visibility IN (${map && includeArchived ? '0,2' : '0'})',
+      '''(a.owner_id IN $owners OR EXISTS (
+        SELECT 1 FROM remote_album_asset_entity membership
+        JOIN remote_album_entity album ON album.id = membership.album_id
+        WHERE membership.asset_id = a.id AND membership.album_id IN $albums
+        AND EXISTS (SELECT 1 FROM remote_album_user_entity u
+          WHERE u.album_id = album.id AND u.user_id = $mine)
+        AND EXISTS (SELECT 1 FROM remote_album_user_entity u
+          WHERE u.album_id = album.id AND u.user_id <> $other)
+      ))''',
+    ];
+    if (map) {
+      filters.add('e.latitude BETWEEN ${bind(south)} AND ${bind(north)}');
+      if (west <= east) {
+        filters.add('e.longitude BETWEEN ${bind(west)} AND ${bind(east)}');
+      } else {
+        filters.add('(e.longitude >= ${bind(west)} OR e.longitude <= ${bind(east)})');
+      }
+      if (onlyFavorites) {
+        filters.add('a.is_favorite = 1');
+      }
+      if (from != null) {
+        filters.add('julianday(a.created_at) >= julianday(${bind(from.toUtc().toIso8601String())})');
+      }
+      if (to != null) {
+        filters.add('julianday(a.created_at) <= julianday(${bind(to.toUtc().toIso8601String())})');
+      }
+    } else {
+      // Album-only sharing does not synchronize the owner's private stacks.
+      // Treat these shared photos individually, as the album view does. Keep
+      // the stock primary-only rule for the existing owner/partner timeline.
+      final albumOnlyOwner = ownerIds.isEmpty ? '1' : 'a.owner_id NOT IN ${inList(ownerIds)}';
+      filters.add('''($albumOnlyOwner OR a.stack_id IS NULL OR EXISTS (
+        SELECT 1 FROM stack_entity stack WHERE stack.id = a.stack_id AND stack.primary_asset_id = a.id
+      ))''');
+    }
+    final preferredOwner = bind(currentUserId);
+    return SharedAlbumSql('''
+WITH eligible AS (
+  SELECT a.*${map ? ', e.latitude, e.longitude' : ''}
+  FROM remote_asset_entity a
+  ${map ? 'JOIN remote_exif_entity e ON e.asset_id = a.id' : ''}
+  WHERE ${filters.join(' AND ')}
+), ranked AS (
+  SELECT eligible.*, ROW_NUMBER() OVER (
+    PARTITION BY checksum, CASE WHEN checksum = '' THEN id ELSE '' END
+    ORDER BY (owner_id = $preferredOwner) DESC, id
+  ) AS checksum_rank FROM eligible
+), visible_remote AS (
+  SELECT * FROM ranked WHERE checksum_rank = 1
+)
+''', arguments);
+  }
+
+  SharedAlbumSql mainRows(List<String> ownerIds) {
+    final owners = ownerIds.isEmpty ? '(NULL)' : '(${List.filled(ownerIds.length, '?').join(',')})';
+    return SharedAlbumSql(
+      '''$sql, visible AS (
+  SELECT a.id AS remote_id,
+    (SELECT l.id FROM local_asset_entity l WHERE l.checksum = a.checksum ORDER BY l.id LIMIT 1) AS local_id,
+    a.created_at, a.local_date_time
+  FROM visible_remote a
+  UNION ALL
+  SELECT NULL AS remote_id, l.id AS local_id, l.created_at, NULL AS local_date_time
+  FROM local_asset_entity l
+  WHERE NOT EXISTS (SELECT 1 FROM remote_asset_entity a
+    WHERE a.checksum = l.checksum AND a.owner_id IN $owners)
+  AND NOT EXISTS (SELECT 1 FROM visible_remote a WHERE a.checksum = l.checksum)
+  AND EXISTS (SELECT 1 FROM local_album_asset_entity laa
+    JOIN local_album_entity la ON la.id = laa.album_id
+    WHERE laa.asset_id = l.id AND la.backup_selection = 0)
+  AND NOT EXISTS (SELECT 1 FROM local_album_asset_entity laa
+    JOIN local_album_entity la ON la.id = laa.album_id
+    WHERE laa.asset_id = l.id AND la.backup_selection = 2)
+)
+''',
+      [...arguments, ...ownerIds],
+    );
+  }
+}
